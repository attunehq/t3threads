{
  "name": "t3threads",
  "version": "0.2.1",
  "description": "Discover, search, summarize, classify, watch, and manage T3 Code threads across machines.",
  "type": "module",
  "license": "MIT",
  "author": "jssblck",
  "repository": {
    "type": "git",
    "url": "https://github.com/attunehq/t3threads.git"
  },
  "bin": {
    "t3threads": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "postinstall": "node scripts/postinstall.mjs",
    "skills:update": "node scripts/skills-update.mjs",
    "dev": "node --import tsx src/bin.ts"
  },
  "dependencies": {
    "incur": "0.5.1",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "ws": "^8.18.0"
  }
}
